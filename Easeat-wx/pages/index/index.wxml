<view class="page">
  <view class="hero">
    <image class="hero-logo" src="/images/logo.svg" mode="aspectFill" />
    <view>
      <view class="hero-title">易位 eaSEAT</view>
      <view class="hero-sub">一键排座位 · 每周自动轮换</view>
    </view>
  </view>

  <view wx:if="{{showNotice}}" class="notice" hover-class="btn-hover" bindtap="openNotice">
    <view class="notice-badge">新</view>
    <view class="notice-text">易位 2.0：大组轮换、不相邻名单、每周自动重排</view>
    <view class="list-arrow"></view>
  </view>

  <view class="actions">
    <view class="action" hover-class="btn-hover" bindtap="showCreate">
      <view class="action-icon">＋</view>
      <view class="action-title">创建班级</view>
      <view class="action-sub">老师排座位</view>
    </view>
    <view wx:if="{{local}}" class="action" hover-class="btn-hover" bindtap="createDemo">
      <view class="action-icon join">试</view>
      <view class="action-title">示例班级</view>
      <view class="action-sub">先体验一下</view>
    </view>
    <view wx:else class="action" hover-class="btn-hover" bindtap="showJoin">
      <view class="action-icon join">→</view>
      <view class="action-title">加入班级</view>
      <view class="action-sub">学生、家长查看座位</view>
    </view>
  </view>

  <block wx:if="{{loaded}}">
    <view wx:if="{{owned.length}}" class="section-title">{{local ? '我的班级' : '我创建的班级'}}</view>
    <view
      wx:for="{{owned}}"
      wx:key="id"
      class="class-item"
      hover-class="list-hover"
      data-id="{{item.id}}"
      bindtap="openClass"
    >
      <view class="class-main">
        <view class="class-name">{{item.name}}</view>
        <view wx:if="{{item.meta}}" class="class-id">{{item.meta}}</view>
      </view>
      <view class="class-op" hover-class="btn-hover" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="deleteClass">删除</view>
    </view>

    <view wx:if="{{joined.length}}" class="section-title">我加入的班级</view>
    <view
      wx:for="{{joined}}"
      wx:key="id"
      class="class-item"
      hover-class="list-hover"
      data-id="{{item.id}}"
      bindtap="openClass"
    >
      <view class="class-main">
        <view class="class-name">{{item.name}}</view>
        <view wx:if="{{item.meta}}" class="class-id">{{item.meta}}</view>
      </view>
      <view class="class-op" hover-class="btn-hover" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="quitClass">退出</view>
    </view>

    <view wx:if="{{!owned.length && !joined.length}}" class="empty">
      <image class="empty-image" src="/images/no_data.png" />
      <text wx:if="{{local}}" class="empty-text">还没有班级。\n点「创建班级」开始，或先打开「示例班级」体验一下。</text>
      <text wx:else class="empty-text">还没有班级。\n老师请先创建班级；学生和家长请向老师要班级 ID，\n或直接点开老师分享的班级卡片。</text>
    </view>
    <view wx:if="{{local}}" class="local-note">班级数据保存在这台设备上。换手机前请在「我的 → 备份与恢复」导出备份。</view>
  </block>
</view>

<input-dialog
  wx:if="{{dialog}}"
  title="{{dialog.title}}"
  hint="{{dialog.hint}}"
  placeholder="{{dialog.placeholder}}"
  maxlength="{{dialog.maxlength}}"
  confirmText="{{dialog.confirmText}}"
  bindconfirm="onDialogConfirm"
  bindcancel="closeDialog"
/>
