<view class="page">
  <view wx:for="{{sections}}" wx:key="key" class="card">
    <view class="card-header" data-index="{{index}}" bindtap="toggle">
      <view class="card-title">{{item.title}}</view>
      <image class="chevron {{item.open ? '' : 'closed'}}" src="/images/drop_down.svg" />
    </view>
    <view wx:if="{{item.open}}" class="card-body">
      <view wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="n" wx:key="*this" class="step">
        <view class="step-no">{{n + 1}}</view>
        <view class="step-text">{{step}}</view>
      </view>
    </view>
  </view>
</view>
