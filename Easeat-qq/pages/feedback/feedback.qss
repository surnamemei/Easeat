.intro {
  margin: 12rpx 0 28rpx;
}

.group {
  margin-top: 16rpx;
}

.link-box {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #f4f7f9;
}

.link-main {
  flex: 1;
  min-width: 0;
}

.link-text {
  font-size: 26rpx;
  word-break: break-all;
}
