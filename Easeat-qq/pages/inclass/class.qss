.center {
  text-align: center;
}

.link {
  color: #1683c0;
}

/* 班级信息 */
.head {
  display: flex;
  align-items: center;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-name {
  font-size: 38rpx;
  font-weight: 700;
  word-break: break-all;
}

.head-meta {
  margin-top: 8rpx;
}

.head-id {
  margin-left: 12rpx;
}

/* 座位表 */
.chart-time {
  margin-top: 4rpx;
}

.chart-gap {
  margin-top: 20rpx;
}

.chart-scroll {
  /* 座位表比卡片内容区左右各宽 12rpx，手机上能放下更大的字 */
  width: auto;
  margin: 20rpx -12rpx 0;
}

.chart {
  margin: 0 auto;
}

.podium {
  width: 240rpx;
  margin: 0 auto 20rpx;
  padding: 10rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1683c0;
  background: #e8f5f8;
}

.podium.bottom {
  margin: 12rpx auto 0;
}

.podium.small {
  width: 200rpx;
  padding: 6rpx 0;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.chart-row {
  display: flex;
  margin-bottom: 6rpx;
}

.cell {
  flex-shrink: 0;
  height: 76rpx;
  margin: 0 3rpx;
  border-radius: 10rpx;
}

.cell.desk,
.cell.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 3rpx;
  text-align: center;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
}

.cell.wrap {
  white-space: normal;
  word-break: break-all;
}

.cell.desk {
  color: #1f2933;
  background: #eef7fc;
  border: 2rpx solid #a9d6ee;
}

.cell.empty {
  background: #ffffff;
  border: 2rpx dashed #ccd5de;
}

.cell.selected {
  color: #ffffff;
  background: #1683c0;
  border-color: #1683c0;
}

.select-bar {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f4f7f9;
}

.select-text {
  flex: 1;
  font-size: 24rpx;
  color: #4a5562;
}

.select-bar .btn {
  margin-left: 12rpx;
}

.select-cancel {
  background: #ffffff;
}

.modes {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f4f7f9;
}

.mode {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #4a5562;
}

.mode.on {
  font-weight: 600;
  color: #1683c0;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(15, 40, 60, 0.08);
}

.mode-desc {
  margin: 12rpx 4rpx 24rpx;
}

.export-only {
  margin-top: 24rpx;
}

.export {
  margin-top: 20rpx;
  border-radius: 14rpx;
  background: #f4f7f9;
  overflow: hidden;
}

.export-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #e3e8ee;
}

.export-item:last-child {
  border-bottom: none;
}

.export-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1683c0;
}

.share-intro {
  margin-bottom: 20rpx;
}

/* 学生名单 */
.add-row {
  display: flex;
  align-items: center;
}

.add-name {
  flex: 1;
  min-width: 0;
}

.add-height {
  width: 190rpx;
  margin-left: 12rpx;
}

.add-btn {
  margin-left: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.more-add {
  margin-top: 16rpx;
}

.batch {
  margin-top: 16rpx;
}

.batch-text {
  width: 100%;
  height: 300rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #f4f7f9;
  border-radius: 12rpx;
}

.roster-hint {
  margin: 16rpx 0 12rpx;
}

.student {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 1rpx solid #eef2f6;
}

.student:last-child {
  border-bottom: none;
}

.student-no {
  width: 64rpx;
  font-size: 24rpx;
  color: #9aa5b1;
}

.student-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-height {
  width: 150rpx;
  font-size: 26rpx;
  color: #6b7785;
  text-align: right;
}

.student-del {
  margin-left: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #d93a3f;
  background: #fdeeee;
}

/* 排座规则 */
.rule {
  display: flex;
  align-items: center;
}

.rule-main {
  flex: 1;
  margin-right: 20rpx;
}

.rule-title {
  font-size: 30rpx;
  font-weight: 500;
}

.pairs-title {
  margin-top: 36rpx;
}

.pair {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #f4f7f9;
}

.pair-text {
  flex: 1;
}

.pair-del {
  font-size: 24rpx;
  color: #d93a3f;
}

.pair-add {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.picker {
  flex: 1;
  min-width: 0;
}

.picker-value {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f4f7f9;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pair-sep {
  margin: 0 12rpx;
  color: #9aa5b1;
}

.pair-add .btn {
  margin-left: 12rpx;
}

/* 教室布局 */
.steppers {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 0;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-label {
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #4a5562;
}

.step {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 34rpx;
  color: #1683c0;
  background: #e8f5f8;
}

.step-value {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.draft {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.draft-row {
  display: flex;
  margin-bottom: 8rpx;
}

.draft-cell {
  margin: 0 4rpx;
  border-radius: 8rpx;
  background: #eef2f6;
}

.draft-cell.on {
  background: #52beee;
}

.draft-count {
  margin: 16rpx 0 24rpx;
}

/* 分享 */
.id-box {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: #f4f7f9;
}

.id-main {
  flex: 1;
}

.id-text {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  font-family: Menlo, Consolas, monospace;
}

.share-hint {
  margin-top: 16rpx;
}

.chart-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
}
