.step {
  display: flex;
  margin-top: 16rpx;
}

.step-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin: 4rpx 18rpx 0 0;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  color: #1683c0;
  background: #e8f5f8;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.75;
  color: #3a4552;
}
