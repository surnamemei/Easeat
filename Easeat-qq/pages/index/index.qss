.hero {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 32rpx;
}

.hero-logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  margin-right: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #6b7785;
}

.notice {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  background: #e8f5f8;
  border-radius: 16rpx;
}

.notice-badge {
  flex-shrink: 0;
  padding: 0 12rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  color: #ffffff;
  background: #1683c0;
}

.notice-text {
  flex: 1;
  font-size: 26rpx;
  color: #155e86;
}

.actions {
  display: flex;
  margin: 0 -10rpx;
}

.action {
  flex: 1;
  margin: 0 10rpx;
  padding: 32rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 40, 60, 0.04);
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: #1683c0;
}

.action-icon.join {
  color: #1683c0;
  background: #e8f5f8;
}

.action-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.action-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6b7785;
}

.class-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.class-main {
  flex: 1;
  min-width: 0;
}

.class-name {
  font-size: 32rpx;
  font-weight: 500;
  word-break: break-all;
}

.class-id {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9aa5b1;
}

.class-op {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #6b7785;
  background: #f4f7f9;
}

.local-note {
  margin: 32rpx 16rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9aa5b1;
  text-align: center;
}
