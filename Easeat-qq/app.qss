/**app.wxss**/
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
view {
  box-sizing: border-box;
  font-family: PingFangSC-Regular, Roboto, Helvetica Neue, Helvetica, Tahoma, Arial, PingFang SC-Light, Microsoft YaHei;
}
button {
  margin: 0;
  padding: 0;
  border: 1px solid transparent;
  outline: none;
  background-color: transparent;
}
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-row {
  display: flex;
  flex-direction: row;
}

@import 'styles/weui.qss';
@import 'styles/font.qss';
@import 'styles/color.qss';
@import 'styles/icon.qss';
@import 'styles/ui.qss';
@import 'styles/helper.qss';

page {
  background-color: #f0eff5;
  padding-bottom: 1rpx; /* 试图解决 load-more 底部 margin 不显示的问题 */
}
/**
 * 组件展示页相关
 */
.page {
  min-height: 100vh;
  background-color: #f8f8f8;
}

.page__hd {
  padding: 40px;
}

.page__bd {
  padding-bottom: 40px;
}

.page__bd--spacing {
  padding-left: 15px;
  padding-right: 15px;
}

.page__ft {
  padding-bottom: 10px;
  text-align: center;
}

.page__title {
  text-align: left;
  font-size: 20px;
  font-weight: 400;
}

.page__desc {
  margin-top: 5px;
  color: #888888;
  text-align: left;
  font-size: 14px;
}
.page__bd > .page__desc {
  margin-left: 15px;
}
.page__bd.page__bd--spacing > .page__desc {
  margin-left: 0;
}

.page__section-title {
  margin-top: 1.2em;
  margin-left: 15px;
  margin-bottom: 0.6em;
  /*color: #353535;*/
  text-align: left;
  font-size: 14px;
  /*font-weight: bold;*/
}

.page__section-title--first {
  margin-top: 0;
}

.page__bd--spacing > .page__section-title {
  margin-left: 0;
}

.page__placeholder {
  padding: 50px 0;
  text-align: center;
}
